    <bpmn:sequenceFlow id="Edge4" sourceRef="Gateway" targetRef="Outcome0" name="Complete" />
    <bpmn:sequenceFlow id="Edge5" sourceRef="Outcome0" targetRef="End0" name="" />
    <bpmn:sequenceFlow id="Edge6" sourceRef="Gateway" targetRef="Outcome1" name="Incomplete" />
    <bpmn:sequenceFlow id="Edge7" sourceRef="Outcome1" targetRef="End1" name="" />
  </bpmn:process>
