<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Credence" targetNamespace="urn:credence">
  <bpmn:process id="Flow" isExecutable="false">
    <bpmn:startEvent id="Start" name="" />
    <bpmn:task id="Task0" name="Edit draft and add documents" />
    <bpmn:task id="Task1" name="Check membership and revision" />
    <bpmn:task id="Task2" name="Evaluate pinned product rules" />
    <bpmn:exclusiveGateway id="Gateway" name="Outcome" />
    <bpmn:task id="Outcome0" name="Commit snapshot and SUBMITTED" />
    <bpmn:endEvent id="End0" name="" />
    <bpmn:task id="Outcome1" name="Return failed checks" />
    <bpmn:endEvent id="End1" name="" />
