@startuml
actor Applicant
actor Analyst
actor "Risk officer" as Risk
actor Administrator
rectangle Credence {
 (Submit and supplement application) as Submit
 (Validate, assess and recommend) as Review
 (Decide application) as Decide
 (Respond to offer) as Respond
 (Maintain products and accounts) as Admin
}
Applicant --> Submit
Applicant --> Respond
Analyst --> Review
Risk --> Decide
Administrator --> Admin
@enduml
