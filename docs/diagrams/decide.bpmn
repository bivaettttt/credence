    <bpmn:sequenceFlow id="Edge3" sourceRef="Gateway" targetRef="Outcome0" name="Approve" />
    <bpmn:sequenceFlow id="Edge4" sourceRef="Outcome0" targetRef="End0" name="" />
    <bpmn:sequenceFlow id="Edge5" sourceRef="Gateway" targetRef="Outcome1" name="Reject" />
    <bpmn:sequenceFlow id="Edge6" sourceRef="Outcome1" targetRef="End1" name="" />
    <bpmn:sequenceFlow id="Edge7" sourceRef="Gateway" targetRef="Outcome2" name="Return" />
    <bpmn:sequenceFlow id="Edge8" sourceRef="Outcome2" targetRef="End2" name="" />
