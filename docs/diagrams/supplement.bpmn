<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Credence" targetNamespace="urn:credence">
  <bpmn:process id="Flow" isExecutable="false">
    <bpmn:startEvent id="Start" name="" />
    <bpmn:task id="Task0" name="Request additional information" />
    <bpmn:task id="Task1" name="Clear current evidence and notify applicant" />
    <bpmn:task id="Task2" name="Amend draft and documents" />
    <bpmn:task id="Task3" name="Submit fresh snapshot" />
    <bpmn:endEvent id="End" name="" />
    <bpmn:sequenceFlow id="Edge0" sourceRef="Start" targetRef="Task0" name="" />
    <bpmn:sequenceFlow id="Edge1" sourceRef="Task0" targetRef="Task1" name="" />
    <bpmn:sequenceFlow id="Edge2" sourceRef="Task1" targetRef="Task2" name="" />
    <bpmn:sequenceFlow id="Edge3" sourceRef="Task2" targetRef="Task3" name="" />
    <bpmn:sequenceFlow id="Edge4" sourceRef="Task3" targetRef="End" name="" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="View">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Flow">
