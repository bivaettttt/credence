      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task3Shape" bpmnElement="Task3">
        <dc:Bounds x="650" y="90" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndShape" bpmnElement="End">
        <dc:Bounds x="835" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge0Diagram" bpmnElement="Edge0">
        <di:waypoint x="56" y="130" />
        <di:waypoint x="95" y="130" />
